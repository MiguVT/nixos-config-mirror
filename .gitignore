# Nix build artifacts (result is a symlink to the last build)
result
result-*

# Auto-generated by nixos-generate-config (machine-specific disk UUIDs)
hardware-configuration.nix

# Local, machine-specific overrides (keep out of VCS)
local/
*.local.nix

# Secrets (agenix / sops-nags / nix-secrets)
secrets/

# Editor and OS cruft
*~
.#*
.*.swp
.DS_Store
